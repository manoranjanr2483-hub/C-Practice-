{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ (MinGW)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$p = Get-Process -Name '${fileBasenameNoExtension}' -ErrorAction SilentlyContinue; if ($p) { $p | Stop-Process -Force }; & g++ '${file}' -std=c++17 -mconsole '-Wl,--subsystem,console' -o '${workspaceFolder}/${fileBasenameNoExtension}.exe'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Build all C++ files in folder",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-ChildItem -Path '${workspaceFolder}' -Filter *.cpp | Where-Object { $_.Length -gt 0 -and ((Get-Content $_.FullName -Raw -ErrorAction SilentlyContinue) -match '\\bmain\\s*\\(') } | ForEach-Object { $exe = Join-Path '${workspaceFolder}' ($_.BaseName + '.exe'); $p = Get-Process -Name $_.BaseName -ErrorAction SilentlyContinue; if ($p) { $p | Stop-Process -Force }; & g++ $_.FullName -std=c++17 -mconsole '-Wl,--subsystem,console' -o $exe }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
